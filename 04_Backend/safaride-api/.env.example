# SafeRide OS Backend Configuration
# Copy this file to .env and fill in the values

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (SQLite)
DB_FILE_PATH=./safaride.db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h

# Socket.IO Configuration
SOCKET_IO_ORIGIN=*  # In production, specify your frontend URL

# File Upload Configuration (for audio recordings)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_AUDIO_TYPES=audio/wav,audio/mp3,audio/m4a

# Audio Processing
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# External Service APIs (if needed)
# MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
# GEOCODING_API_KEY=your_geocoding_api_key_here

# Safety Thresholds
UNSAFE_SPEED_THRESHOLD=80  # km/h
UNSAFE_ACCELERATION_THRESHOLD=5  # m/s^2
EMERGENCY_BUTTON_HOLD_TIME=1000  # milliseconds

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/safaride.log

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=*  # In production, specify your frontend URL
